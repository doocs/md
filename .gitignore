# pnpm-lock.yaml
# NOTE: apps/web/auto-imports.d.ts and components.d.ts are committed on
# purpose — the CI type-check job runs vue-tsc without a prior vite build,
# so the generated globals must exist in a clean checkout.

.wxt
.output
web-ext.config.ts
.wrangler

# Claude Code local settings
.claude/settings.local.json
# Tracked per-skill git symlinks live under .claude/skills/; ignore extras from `npx skills add`
.claude/skills/*
!.claude/skills/create-pr
!.claude/skills/git-commit
!.claude/skills/wechat-svg

