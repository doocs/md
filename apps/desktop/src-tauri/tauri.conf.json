{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doocs MD",
  "version": "../../../package.json",
  "identifier": "org.doocs.md",
  "build": {
    "beforeDevCommand": "pnpm --filter @md/web dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @md/web build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Doocs MD",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
